<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QBDP — Quality Badge & Digital Protocol</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #1a1a2e; background: white; }
    a { text-decoration: none; color: inherit; }

    /* NAV */
    nav { display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; position: fixed; top: 0; width: 100%; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); z-index: 100; border-bottom: 1px solid #f0f0f0; }
    .nav-logo { display: flex; align-items: center; gap: 10px; }
    .nav-logo img { width: 36px; height: 36px; border-radius: 8px; }
    .nav-logo span { font-size: 20px; font-weight: 700; color: #1a56db; }
    .nav-links { display: flex; gap: 32px; font-size: 14px; color: #6b7280; }
    .nav-links a:hover { color: #1a56db; }
    .nav-cta { background: #1a56db; color: white; padding: 10px 22px; border-radius: 8px; font-size: 14px; font-weight: 600; }
    .nav-cta:hover { background: #1648c0; }

    /* HERO */
    .hero { padding: 160px 48px 100px; text-align: center; background: linear-gradient(180deg, #f0f5ff 0%, #ffffff 100%); }
    .hero-badge { display: inline-block; background: #eff6ff; color: #1a56db; font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 20px; margin-bottom: 24px; border: 1px solid #bfdbfe; }
    .hero h1 { font-size: 58px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; letter-spacing: -1px; }
    .hero h1 span { color: #1a56db; }
    .hero p { font-size: 20px; color: #6b7280; max-width: 560px; margin: 0 auto 40px; line-height: 1.6; }
    .hero-btns { display: flex; gap: 14px; justify-content: center; }
    .btn-primary { background: #1a56db; color: white; padding: 16px 32px; border-radius: 10px; font-size: 16px; font-weight: 600; }
    .btn-primary:hover { background: #1648c0; }
    .btn-secondary { background: white; color: #1a56db; padding: 16px 32px; border-radius: 10px; font-size: 16px; font-weight: 600; border: 2px solid #bfdbfe; }
    .hero-img { margin-top: 64px; max-width: 900px; margin-left: auto; margin-right: auto; background: white; border-radius: 20px; box-shadow: 0 24px 64px rgba(26,86,219,0.12); overflow: hidden; border: 1px solid #e5e7eb; }
    .hero-img img { width: 100%; display: block; }
    .hero-mockup { padding: 32px; text-align: left; }
    .mockup-bar { display: flex; gap: 6px; margin-bottom: 20px; }
    .mockup-dot { width: 12px; height: 12px; border-radius: 50%; }

    /* LOGOS */
    .logos { padding: 48px; text-align: center; border-top: 1px solid #f3f4f6; border-bottom: 1px solid #f3f4f6; }
    .logos p { font-size: 13px; color: #9ca3af; margin-bottom: 24px; text-transform: uppercase; letter-spacing: 0.1em; }
    .logos-grid { display: flex; gap: 48px; justify-content: center; align-items: center; flex-wrap: wrap; }
    .logo-item { font-size: 18px; font-weight: 700; color: #d1d5db; }

    /* FEATURES */
    .features { padding: 100px 48px; }
    .section-label { font-size: 13px; font-weight: 600; color: #1a56db; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px; }
    .section-title { font-size: 42px; font-weight: 800; margin-bottom: 16px; letter-spacing: -0.5px; }
    .section-sub { font-size: 18px; color: #6b7280; max-width: 520px; line-height: 1.6; }
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; }
    .feature-card { background: #f9fafb; border-radius: 16px; padding: 28px; border: 1px solid #f3f4f6; }
    .feature-icon { font-size: 32px; margin-bottom: 16px; }
    .feature-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
    .feature-card p { font-size: 14px; color: #6b7280; line-height: 1.6; }

    /* COMMENT CA MARCHE */
    .how { padding: 100px 48px; background: #f9fafb; }
    .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 56px; }
    .step { text-align: center; padding: 24px; }
    .step-num { width: 48px; height: 48px; background: #1a56db; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; margin: 0 auto 16px; }
    .step h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .step p { font-size: 13px; color: #6b7280; line-height: 1.6; }

    /* PRICING */
    .pricing { padding: 100px 48px; text-align: center; }
    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 900px; margin: 56px auto 0; }
    .pricing-card { border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; text-align: left; }
    .pricing-card.popular { border-color: #1a56db; background: #f0f5ff; }
    .popular-badge { background: #1a56db; color: white; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 10px; display: inline-block; margin-bottom: 16px; }
    .pricing-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
    .pricing-price { font-size: 36px; font-weight: 800; color: #1a56db; margin-bottom: 4px; }
    .pricing-price span { font-size: 16px; font-weight: 400; color: #6b7280; }
    .pricing-desc { font-size: 13px; color: #6b7280; margin-bottom: 24px; }
    .pricing-features { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
    .pricing-features li { font-size: 13px; color: #374151; display: flex; gap: 8px; }
    .pricing-features li::before { content: "✓"; color: #16a34a; font-weight: 700; }
    .pricing-btn { width: 100%; padding: 12px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; background: #1a56db; color: white; }
    .pricing-card:not(.popular) .pricing-btn { background: white; color: #1a56db; border: 2px solid #bfdbfe; }

    /* CTA */
    .cta { padding: 100px 48px; background: #1a56db; text-align: center; color: white; }
    .cta h2 { font-size: 42px; font-weight: 800; margin-bottom: 16px; }
    .cta p { font-size: 18px; opacity: 0.85; margin-bottom: 40px; }
    .cta-btn { background: white; color: #1a56db; padding: 16px 40px; border-radius: 10px; font-size: 16px; font-weight: 700; display: inline-block; }

    /* FOOTER */
    footer { padding: 48px; border-top: 1px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center; }
    .footer-logo { display: flex; align-items: center; gap: 10px; }
    .footer-logo span { font-size: 18px; font-weight: 700; color: #1a56db; }
    footer p { font-size: 13px; color: #9ca3af; }

    @media (max-width: 768px) {
      nav { padding: 16px 20px; }
      .nav-links { display: none; }
      .hero { padding: 120px 20px 60px; }
      .hero h1 { font-size: 36px; }
      .hero p { font-size: 16px; }
      .hero-btns { flex-direction: column; align-items: center; }
      .features { padding: 60px 20px; }
      .features-grid { grid-template-columns: 1fr; }
      .how { padding: 60px 20px; }
      .steps { grid-template-columns: repeat(2, 1fr); }
      .pricing { padding: 60px 20px; }
      .pricing-grid { grid-template-columns: 1fr; }
      .cta { padding: 60px 20px; }
      .cta h2 { font-size: 28px; }
      footer { flex-direction: column; gap: 16px; text-align: center; padding: 32px 20px; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">
    <img src="https://qbdp-mobile.vercel.app/logo.png" alt="QBDP" />
    <span>qbdp</span>
  </div>
  <div class="nav-links">
    <a href="#fonctionnalites">Fonctionnalités</a>
    <a href="#comment">Comment ça marche</a>
    <a href="#tarifs">Tarifs</a>
  </div>
  <a href="https://qbdp-admin.vercel.app" class="nav-cta">Accéder au dashboard</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-badge">🛡️ Quality Badge & Digital Protocol</div>
  <h1>Le badge d'accès<br /><span>100% digital</span></h1>
  <p>Remplacez vos badges physiques par une app mobile. Gérez les accès de vos employés en temps réel, depuis n'importe où.</p>
  <div class="hero-btns">
    <a href="https://qbdp-admin.vercel.app" class="btn-primary">Démarrer gratuitement</a>
    <a href="#comment" class="btn-secondary">Voir la démo</a>
  </div>
  <div class="hero-img">
    <div class="hero-mockup">
      <div class="mockup-bar">
        <div class="mockup-dot" style="background:#ff5f57"></div>
        <div class="mockup-dot" style="background:#febc2e"></div>
        <div class="mockup-dot" style="background:#28c840"></div>
      </div>
      <div style="display:flex;gap:16px;align-items:flex-start">
        <div style="width:200px;background:#f9fafb;border-radius:10px;padding:16px;border:1px solid #e5e7eb">
          <div style="font-size:11px;font-weight:600;color:#6b7280;margin-bottom:12px">MENU</div>
          <div style="font-size:13px;font-weight:600;color:#1a56db;padding:8px;background:#eff6ff;border-radius:6px;margin-bottom:4px">Vue générale</div>
          <div style="font-size:13px;color:#6b7280;padding:8px">Employés</div>
          <div style="font-size:13px;color:#6b7280;padding:8px">Accès & zones</div>
          <div style="font-size:13px;color:#6b7280;padding:8px">Historique</div>
        </div>
        <div style="flex:1">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px">
            <div style="background:#eff6ff;border-radius:10px;padding:16px;border:1px solid #bfdbfe">
              <div style="font-size:22px;font-weight:800;color:#1a56db">24</div>
              <div style="font-size:11px;color:#6b7280;margin-top:2px">Employés actifs</div>
            </div>
            <div style="background:#f0fdf4;border-radius:10px;padding:16px;border:1px solid #86efac">
              <div style="font-size:22px;font-weight:800;color:#16a34a">6</div>
              <div style="font-size:11px;color:#6b7280;margin-top:2px">Zones actives</div>
            </div>
            <div style="background:#fef9c3;border-radius:10px;padding:16px;border:1px solid #fde047">
              <div style="font-size:22px;font-weight:800;color:#ca8a04">142</div>
              <div style="font-size:11px;color:#6b7280;margin-top:2px">Entrées aujourd'hui</div>
            </div>
          </div>
          <div style="background:#f9fafb;border-radius:10px;padding:16px;border:1px solid #e5e7eb">
            <div style="font-size:12px;font-weight:600;color:#374151;margin-bottom:12px">Dernières entrées</div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px">
                <span style="color:#1a1a2e;font-weight:500">Marie Dupont</span>
                <span style="color:#16a34a;font-size:11px">Entrée principale</span>
                <span style="color:#9ca3af">09:42</span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px">
                <span style="color:#1a1a2e;font-weight:500">Jean Martin</span>
                <span style="color:#16a34a;font-size:11px">Parking</span>
                <span style="color:#9ca3af">09:38</span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px">
                <span style="color:#1a1a2e;font-weight:500">Sara Blanc</span>
                <span style="color:#16a34a;font-size:11px">Salle serveur</span>
                <span style="color:#9ca3af">09:31</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LOGOS -->
<section class="logos">
  <p>Ils nous font confiance</p>
  <div class="logos-grid">
    <div class="logo-item">ACME Corp</div>
    <div class="logo-item">TechPro</div>
    <div class="logo-item">Groupe BTP</div>
    <div class="logo-item">LogiStar</div>
    <div class="logo-item">MedCenter</div>
  </div>
</section>

<!-- FEATURES -->
<section class="features" id="fonctionnalites">
  <div class="section-label">Fonctionnalités</div>
  <div class="section-title">Tout ce dont vous avez besoin</div>
  <div class="section-sub">Une solution complète pour remplacer vos badges physiques et gérer vos accès en temps réel.</div>
  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">📱</div>
      <h3>Badge digital</h3>
      <p>Chaque employé dispose d'un badge sur son smartphone. Fini les badges perdus ou oubliés.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🔐</div>
      <h3>Contrôle d'accès</h3>
      <p>Définissez qui peut accéder à quelle zone et à quelle heure. Modifiable en temps réel.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">📊</div>
      <h3>Dashboard admin</h3>
      <p>Visualisez toutes les entrées et sorties en temps réel depuis votre navigateur.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">📧</div>
      <h3>Invitation par email</h3>
      <p>Ajoutez un employé et envoyez-lui une invitation par email en un clic. Activation en 2 minutes.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🏠</div>
      <h3>Extension privée</h3>
      <p>Les employés peuvent étendre l'app à leur domicile : portail, garage, alarme. À 2€/mois.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">⚡</div>
      <h3>Module IoT ESP32</h3>
      <p>Connectez un module hardware (~15€) à votre portail ou garage. Installation en 10 minutes.</p>
    </div>
  </div>
</section>

<!-- COMMENT CA MARCHE -->
<section class="how" id="comment">
  <div style="text-align:center">
    <div class="section-label">Comment ça marche</div>
    <div class="section-title">Opérationnel en 10 minutes</div>
    <div class="section-sub" style="margin:0 auto">De la création du compte à la première ouverture de porte.</div>
  </div>
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <h3>Créez votre compte</h3>
      <p>Inscrivez-vous sur le dashboard admin et configurez votre entreprise.</p>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <h3>Ajoutez vos employés</h3>
      <p>Importez ou ajoutez vos employés manuellement avec leur email.</p>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <h3>Invitez-les</h3>
      <p>Un email est envoyé automatiquement. L'employé crée son mot de passe en 1 clic.</p>
    </div>
    <div class="step">
      <div class="step-num">4</div>
      <h3>C'est prêt !</h3>
      <p>L'employé ouvre les portes depuis son smartphone. Vous suivez tout en temps réel.</p>
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="pricing" id="tarifs">
  <div class="section-label">Tarifs</div>
  <div class="section-title">Simple et transparent</div>
  <div class="section-sub" style="margin:0 auto">Pas de frais cachés. Résiliable à tout moment.</div>
  <div class="pricing-grid">
    <div class="pricing-card">
      <h3>Starter</h3>
      <div class="pricing-price">Gratuit</div>
      <div class="pricing-desc">Pour tester QBDP</div>
      <ul class="pricing-features">
        <li>Jusqu'à 5 employés</li>
        <li>1 bâtiment</li>
        <li>Historique 7 jours</li>
        <li>Support email</li>
      </ul>
      <button class="pricing-btn" onclick="window.location.href='https://qbdp-admin.vercel.app'">Commencer</button>
    </div>
    <div class="pricing-card popular">
      <div class="popular-badge">Le plus populaire</div>
      <h3>Business</h3>
      <div class="pricing-price">2€ <span>/ employé / mois</span></div>
      <div class="pricing-desc">Pour les entreprises</div>
      <ul class="pricing-features">
        <li>Employés illimités</li>
        <li>Bâtiments illimités</li>
        <li>Historique illimité</li>
        <li>Support prioritaire</li>
        <li>Extension privée incluse</li>
      </ul>
      <button class="pricing-btn" onclick="window.location.href='https://qbdp-admin.vercel.app'">Démarrer</button>
    </div>
    <div class="pricing-card">
      <h3>Enterprise</h3>
      <div class="pricing-price">Sur devis</div>
      <div class="pricing-desc">Pour les grands comptes</div>
      <ul class="pricing-features">
        <li>Tout Business inclus</li>
        <li>SSO / LDAP</li>
        <li>API REST dédiée</li>
        <li>SLA garanti 99.9%</li>
        <li>Account manager dédié</li>
      </ul>
      <button class="pricing-btn">Nous contacter</button>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <h2>Prêt à digitaliser vos badges ?</h2>
  <p>Rejoignez les entreprises qui ont déjà adopté QBDP.</p>
  <a href="https://qbdp-admin.vercel.app" class="cta-btn">Démarrer gratuitement →</a>
</section>

<!-- FOOTER -->
<footer>
  <div class="footer-logo">
    <img src="https://qbdp-mobile.vercel.app/logo.png" alt="QBDP" style="width:28px;height:28px;border-radius:6px" />
    <span>qbdp</span>
  </div>
  <p>© 2026 QBDP — Quality Badge & Digital Protocol</p>
  <p style="font-size:13px;color:#9ca3af">Made with ❤️ in France</p>
</footer>

</body>
</html>
